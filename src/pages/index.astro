// Body copy is greeked — replace before anything real ships.

const samples = [
  {
    id: "SAMPLE-001",
    family: "Credential harvest",
    host: "login.example-notabank[.]invalid",
    verdict: "malicious",
  },
  {
    id: "SAMPLE-002",
    family: "Invoice fraud",
    host: "billing.example-supplier[.]invalid",
    verdict: "malicious",
  },
  {
    id: "SAMPLE-003",
    family: "Delivery lure",
    host: "track.example-courier[.]invalid",
    verdict: "suspicious",
  },
  {
    id: "SAMPLE-004",
    family: "Callback scam",
    host: "support.example-helpdesk[.]invalid",
    verdict: "inconclusive",
  },
];

const nav = [
  { id: "overview", label: "Overview" },
  { id: "samples", label: "Recent samples" },
  { id: "method", label: "Method" },
  { id: "tooling", label: "Tooling" },
